{
  "name": "tatoz",
  "version": "1.0.0",
  "description": "Tatoz - AI-Powered E-Commerce Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run client\"",
    "build": "npm run build:client",
    "build:client": "npm --prefix client run build",
    "qa:selenium": "node tests/selenium.deepdive.cjs",
    "qa:selenium:page-builder": "node tests/selenium.pagebuilder.cjs",
    "qa:selenium:bug-report": "node tests/selenium.bug-report.cjs",
  "qa:selenium:pdf": "node tests/selenium.abs-bug-report.cjs",
  "qa:selenium:unique-dashboard": "node tests/selenium.unique-dashboard-bugs.cjs",
    "qa:selenium:public": "node tests/selenium.public.cjs",
    "qa:selenium:multivendor": "node tests/selenium.multivendor.cjs",
    "qa:selenium:all": "node scripts/runQualityGate.cjs selenium",
    "gate:brick": "node scripts/runQualityGate.cjs full",
    "worker": "node worker.js",
    "migrate:tenants": "node scripts/migrateTenants.js",
    "migrate:vendor-tenants": "node scripts/migrateVendorTenants.js",
    "migrate:invoice-index": "node scripts/migrateInvoiceIndex.js",
    "import:categories": "node scripts/importCategoryMaster.js",
  "migrate:invoice-revisions": "node scripts/migrateInvoiceRevisions.js",
  "repair:unique-dashboard": "node scripts/repairUniqueDashboardData.js",
    "seed:vendor": "node scripts/seedTatozOfficial.js",
    "seed:dummy": "node scripts/seedDummyProducts.js",
    "seed:orders": "node scripts/seedDummyOrders.js",
    "seed:storefront": "node scripts/seedBeautifulStorefront.js",
    "backup": "node scripts/backupRestore.js backup",
    "backup:inspect": "node scripts/backupRestore.js inspect",
    "restore:backup": "node scripts/backupRestore.js restore",
    "test": "MONGOMS_VERSION=7.0.14 jest tests/ --detectOpenHandles --forceExit --setupFiles ./tests/setupMongoMemory.js",
    "verify": "npm test -- --runInBand && npm run build:client"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.859.0",
    "@aws-sdk/s3-request-presigner": "^3.859.0",
    "@google-cloud/secret-manager": "^6.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@sentry/node": "^10.69.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.3",
    "slugify": "^1.6.6",
    "ua-parser-js": "^1.0.37",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.2",
    "selenium-webdriver": "^4.47.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": [
    "fsevents",
    "mongodb-memory-server",
    "sharp",
    "unrs-resolver"
  ]
}
